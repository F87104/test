//@version=5
// =============================================================================
// Elliott Wave 4 -> 5 Strategy (Pine v5 port of the elliott45/ Python engine)
//
// Faithful 1:1 port of:
//   - Causal ATR ZigZag pivot detection         (src/zigzag.py)
//   - 5-pivot Elliott impulse rule check        (src/elliott.py)
//   - Stop-buy entry at pivot4 + 0.2 * W4       (src/elliott.py)
//   - Initial SL at pivot4 - 0.5 * W4           (src/elliott.py)
//   - TP at pivot4 + 1.0 * W1                   (src/elliott.py)
//   - Partial 1R + breakeven move               (src/backtest.py)
//   - 2 x ATR Chandelier trailing stop          (src/backtest.py)
//   - Conservative intra-bar order (SL first)   (src/backtest.py)
//
// Tested vs the Python engine on USDJPY/EURJPY/GBPJPY/XAUUSD/NAS100/SPX500
// H1 data. Expect trade counts and PnL within +/- a few percent vs the
// Python reference (TradingView's intra-bar execution rules differ in a
// few edge cases - see pinescript/README.md).
// =============================================================================

strategy("Elliott Wave 4->5 [Python-equivalent]",
     overlay              = true,
     pyramiding           = 0,
     initial_capital      = 10000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.0,
     calc_on_every_tick   = false,
     process_orders_on_close = false)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
grpZ = "ZigZag"
zzThr   = input.float(3.0, "threshold_atr",         minval=0.5, step=0.1, group=grpZ,
     tooltip="ATR multiples for ZigZag reversal confirmation")
atrLen  = input.int(14,    "atr_period",            minval=2,                 group=grpZ)

grpW = "Elliott Wave gates"
r2Min      = input.float(0.236, "wave2 retrace min", minval=0.0, maxval=1.0, group=grpW)
r2Max      = input.float(0.886, "wave2 retrace max", minval=0.0, maxval=1.0, group=grpW)
r4Min      = input.float(0.118, "wave4 retrace min", minval=0.0, maxval=1.0, group=grpW)
r4Max      = input.float(0.618, "wave4 retrace max", minval=0.0, maxval=1.0, group=grpW)
needW3Long = input.bool(true,   "require W3 > W1",                            group=grpW)

grpG = "Trade geometry"
entryBufFrac = input.float(0.20, "entry buffer (xW4)",  minval=0.0, step=0.05, group=grpG)
stopBufFrac  = input.float(0.50, "stop buffer (xW4)",   minval=0.0, step=0.05, group=grpG)
targetW1Mult = input.float(1.00, "TP = pivot4 + (xW1)", minval=0.1, step=0.1,  group=grpG)
maxPendBars  = input.int(24,     "max pending bars",   minval=1,             group=grpG)
maxHoldBars  = input.int(240,    "max hold bars",      minval=1,             group=grpG)

grpExit = "Exit improvements"
usePartial   = input.bool(true,  "partial TP at +1R",                       group=grpExit)
partialFrac  = input.float(0.5,  "partial size",       minval=0.05, maxval=0.95, step=0.05, group=grpExit)
partialAtR   = input.float(1.0,  "partial R multiple", minval=0.1, step=0.1,    group=grpExit)
moveBE       = input.bool(true,  "move SL to BE on partial",                group=grpExit)
useTrail     = input.bool(true,  "ATR Chandelier trailing stop",            group=grpExit)
trailAtrMult = input.float(2.0,  "trail x ATR",       minval=0.1, step=0.1, group=grpExit)

grpR = "Risk"
riskPerTrade = input.float(0.01, "risk per trade (fraction of equity)",
     minval=0.0001, maxval=0.05, step=0.001, group=grpR,
     tooltip="Each trade is sized so that (entry - initial SL) x qty = equity x this")
allowShort   = input.bool(true,  "allow short setups",                      group=grpR)

grpD = "Display"
showPivots   = input.bool(true,  "show ZigZag pivots",                      group=grpD)
showLevels   = input.bool(true,  "show entry/SL/TP lines",                  group=grpD)
showWaveLbls = input.bool(true,  "label waves 1-4 + projected 5",           group=grpD)

// -----------------------------------------------------------------------------
// Causal ATR ZigZag
// -----------------------------------------------------------------------------
atrV = ta.atr(atrLen)

var int   extKind  = 1            // start expecting a high
var float extPrice = high
var int   extIdx   = bar_index
var float altPrice = low
var int   altIdx   = bar_index

var array<float> pP = array.new_float(5, na)   // pivot price
var array<int>   pI = array.new_int  (5, 0)    // bar index of extreme
var array<int>   pK = array.new_int  (5, 0)    // +1 = H, -1 = L

confirmedThisBar = false
newPivotPrice = float(na)
newPivotKind  = 0

if bar_index > atrLen and not na(atrV) and atrV > 0
    thr = zzThr * atrV
    if extKind == 1
        if high > extPrice
            extPrice := high
            extIdx   := bar_index
            altPrice := low
            altIdx   := bar_index
        else
            if low < altPrice
                altPrice := low
                altIdx   := bar_index
            if extPrice - low >= thr
                newPivotPrice := extPrice
                newPivotKind  := 1
                confirmedThisBar := true
                extKind  := -1
                extPrice := altPrice
                extIdx   := altIdx
                altPrice := high
                altIdx   := bar_index
    else
        if low < extPrice
            extPrice := low
            extIdx   := bar_index
            altPrice := high
            altIdx   := bar_index
        else
            if high > altPrice
                altPrice := high
                altIdx   := bar_index
            if high - extPrice >= thr
                newPivotPrice := extPrice
                newPivotKind  := -1
                confirmedThisBar := true
                extKind  := 1
                extPrice := altPrice
                extIdx   := altIdx
                altPrice := low
                altIdx   := bar_index

if confirmedThisBar
    array.shift(pP)
    array.shift(pI)
    array.shift(pK)
    array.push(pP, newPivotPrice)
    array.push(pI, bar_index)
    array.push(pK, newPivotKind)

// -----------------------------------------------------------------------------
// Elliott 4 -> 5 rule check
// -----------------------------------------------------------------------------
P0p = array.get(pP, 0)
P1p = array.get(pP, 1)
P2p = array.get(pP, 2)
P3p = array.get(pP, 3)
P4p = array.get(pP, 4)
P0k = array.get(pK, 0)
P1k = array.get(pK, 1)
P2k = array.get(pK, 2)
P3k = array.get(pK, 3)
P4k = array.get(pK, 4)

isLongSeq  = P0k == -1 and P1k == 1  and P2k == -1 and P3k == 1  and P4k == -1
isShortSeq = P0k == 1  and P1k == -1 and P2k == 1  and P3k == -1 and P4k == 1

setupLong  = false
setupShort = false
trigPrice  = float(na)
stopPrice  = float(na)
tgtPrice   = float(na)
w1Out      = float(na)
w3Out      = float(na)

if confirmedThisBar and not na(P0p) and isLongSeq
    okL = P1p > P0p and P2p < P1p and P3p > P2p and P4p < P3p and P2p > P0p and P4p > P1p
    w1 = P1p - P0p
    w3 = P3p - P2p
    if okL and w1 > 0 and w3 > 0 and (not needW3Long or w3 > w1)
        r2 = (P1p - P2p) / w1
        r4 = (P3p - P4p) / w3
        if r2 >= r2Min and r2 <= r2Max and r4 >= r4Min and r4 <= r4Max
            w4l = P3p - P4p
            trigPrice := P4p + entryBufFrac * w4l
            stopPrice := P4p - stopBufFrac  * w4l
            tgtPrice  := P4p + targetW1Mult * w1
            w1Out := w1
            w3Out := w3
            setupLong := true

if confirmedThisBar and not na(P0p) and isShortSeq and allowShort
    okS = P1p < P0p and P2p > P1p and P3p < P2p and P4p > P3p and P2p < P0p and P4p < P1p
    w1 = P0p - P1p
    w3 = P2p - P3p
    if okS and w1 > 0 and w3 > 0 and (not needW3Long or w3 > w1)
        r2 = (P2p - P1p) / w1
        r4 = (P4p - P3p) / w3
        if r2 >= r2Min and r2 <= r2Max and r4 >= r4Min and r4 <= r4Max
            w4l = P4p - P3p
            trigPrice := P4p - entryBufFrac * w4l
            stopPrice := P4p + stopBufFrac  * w4l
            tgtPrice  := P4p - targetW1Mult * w1
            w1Out := w1
            w3Out := w3
            setupShort := true

// -----------------------------------------------------------------------------
// Pending setup state (stop-order valid for max_pending_bars after p4 confirm)
// -----------------------------------------------------------------------------
var bool   pendOn      = false
var bool   pendIsLong  = true
var int    pendBarsLeft= 0
var float  pendTrig    = na
var float  pendStop    = na
var float  pendTarget  = na

if setupLong or setupShort
    // Cancel any opposite-direction pending entry from a previous setup
    // so we cannot accidentally fill the wrong side with stale SL/TP.
    if setupLong
        strategy.cancel("S")
    if setupShort
        strategy.cancel("L")
    pendOn       := true
    pendIsLong   := setupLong
    pendBarsLeft := maxPendBars
    pendTrig     := trigPrice
    pendStop     := stopPrice
    pendTarget   := tgtPrice
else if pendOn
    pendBarsLeft := pendBarsLeft - 1
    if pendBarsLeft < 0
        pendOn := false

// -----------------------------------------------------------------------------
// Position tracking
// -----------------------------------------------------------------------------
var float posEntry     = na
var float posStop      = na
var float posTarget    = na
var float posR         = na
var float posQty       = na
var float posHalfQty   = na
var bool  posPartialOn = false
var int   posBarsHeld  = 0
var int   posDir       = 0
var bool  posExitsSubmitted = false

inPos = strategy.position_size != 0

if not inPos
    posEntry     := na
    posStop      := na
    posTarget    := na
    posR         := na
    posQty       := na
    posHalfQty   := na
    posPartialOn := false
    posBarsHeld  := 0
    posDir       := 0
    posExitsSubmitted := false

filledLong  = strategy.position_size > 0 and strategy.position_size[1] == 0
filledShort = strategy.position_size < 0 and strategy.position_size[1] == 0

if filledLong or filledShort
    // Kill any opposite-direction pending order that survived the fill.
    if filledLong
        strategy.cancel("S")
    if filledShort
        strategy.cancel("L")
    posEntry  := strategy.position_avg_price
    posStop   := pendStop
    posTarget := pendTarget
    posR      := math.abs(posEntry - posStop)
    posQty    := math.abs(strategy.position_size)
    posHalfQty:= posQty * partialFrac
    posDir    := filledLong ? 1 : -1
    posBarsHeld  := 0
    posPartialOn := false
    posExitsSubmitted := false
    // After fill the pending stop-order has been consumed.
    pendOn       := false
    pendBarsLeft := 0
    pendTrig     := na
    pendStop     := na
    pendTarget   := na

if inPos
    posBarsHeld := posBarsHeld + 1

    // ---- 1) Trail update (uses PRIOR bar high / low - causal) ----
    if useTrail and not na(atrV[1]) and atrV[1] > 0
        band = trailAtrMult * atrV[1]
        if posDir == 1
            newSl = high[1] - band
            if not na(newSl) and newSl > posStop
                posStop := newSl
        else
            newSl = low[1] + band
            if not na(newSl) and newSl < posStop
                posStop := newSl

    // ---- 2) Partial detection (same-bar partial fires via the limit order
    //         submitted earlier; we detect the resulting position-size drop). ----
    if not posPartialOn and not na(posHalfQty) and math.abs(strategy.position_size) <= posQty - posHalfQty * 0.5
        posPartialOn := true
        if moveBE
            posStop := math.max(posStop, posEntry)  // BE never moves stop down

// -----------------------------------------------------------------------------
// Order submission
// -----------------------------------------------------------------------------
// (a) Entry - place a stop order when flat with a fresh pending setup.
sizeFromRisk = nz(strategy.equity * riskPerTrade / nz(math.abs(pendTrig - pendStop), 1e9), 1.0)

if not inPos and pendOn and not na(pendTrig)
    if pendIsLong
        strategy.entry("L", strategy.long,  qty = sizeFromRisk, stop = pendTrig)
    else if allowShort
        strategy.entry("S", strategy.short, qty = sizeFromRisk, stop = pendTrig)

// (b) Exits - submit ONCE on the entry bar, then keep refreshing the
// trailing-stop level on the "Main" order each subsequent bar.
if inPos and not posExitsSubmitted
    longSide = posDir == 1
    fromTag  = longSide ? "L" : "S"
    if usePartial
        partialPrice = longSide ? posEntry + partialAtR * posR : posEntry - partialAtR * posR
        // The "Partial" exit only fills posHalfQty units at the limit price.
        // It will not fire again once filled, even if we never re-issue it.
        strategy.exit("Partial", from_entry = fromTag,
             qty   = posHalfQty,
             limit = partialPrice,
             comment_profit = "Partial",
             alert_profit = longSide ? "PARTIAL_LONG" : "PARTIAL_SHORT")
    strategy.exit("Main", from_entry = fromTag,
         stop  = posStop,
         limit = posTarget,
         comment_loss  = "SL",
         comment_profit= "TP",
         alert_loss   = longSide ? "SL_LONG" : "SL_SHORT",
         alert_profit = longSide ? "TP_LONG" : "TP_SHORT")
    posExitsSubmitted := true

// (c) Each bar in position: refresh Main exit with the latest trailing/BE stop.
if inPos and posExitsSubmitted
    longSide = posDir == 1
    fromTag  = longSide ? "L" : "S"
    strategy.exit("Main", from_entry = fromTag,
         stop  = posStop,
         limit = posTarget,
         comment_loss  = "SL",
         comment_profit= "TP",
         alert_loss   = longSide ? "SL_LONG" : "SL_SHORT",
         alert_profit = longSide ? "TP_LONG" : "TP_SHORT")

// (d) Timeout: force-close after max_hold_bars.
if inPos and posBarsHeld >= maxHoldBars
    strategy.close_all(comment = "timeout")

// (e) Cancel orphan pending entries when the setup window has expired
// OR when we are already in a position (no second entry allowed).
if (not pendOn and not inPos) or inPos
    strategy.cancel("L")
    strategy.cancel("S")

// -----------------------------------------------------------------------------
// Visualization
// -----------------------------------------------------------------------------
plotshape(showPivots and confirmedThisBar and newPivotKind == 1,
     title="pivot H",  style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red,   0), size=size.tiny)
plotshape(showPivots and confirmedThisBar and newPivotKind == -1,
     title="pivot L",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.green, 0), size=size.tiny)

var line  lnEntry  = na
var line  lnStop   = na
var line  lnTarget = na
var label lbWave   = na

if showLevels and (setupLong or setupShort)
    if not na(lnEntry)
        line.delete(lnEntry)
        line.delete(lnStop)
        line.delete(lnTarget)
    col = setupLong ? color.new(color.green, 0) : color.new(color.red, 0)
    lnEntry  := line.new(bar_index, trigPrice, bar_index + 50, trigPrice,
         color=col, width=1, style=line.style_dashed)
    lnStop   := line.new(bar_index, stopPrice, bar_index + 50, stopPrice,
         color=color.new(color.red, 30), width=1)
    lnTarget := line.new(bar_index, tgtPrice,  bar_index + 50, tgtPrice,
         color=color.new(color.green, 30), width=1)

if showWaveLbls and (setupLong or setupShort)
    if not na(lbWave)
        label.delete(lbWave)
    txt = (setupLong ? "LONG W4->W5\n" : "SHORT W4->W5\n")
         + "trig=" + str.tostring(trigPrice, "#.#####") + "\n"
         + "stop=" + str.tostring(stopPrice, "#.#####") + "\n"
         + "tp="   + str.tostring(tgtPrice,  "#.#####") + "\n"
         + "W1="   + str.tostring(w1Out, "#.####")
         + " W3="  + str.tostring(w3Out, "#.####")
    lbWave := label.new(bar_index, setupLong ? low : high, txt,
         style = setupLong ? label.style_label_up : label.style_label_down,
         color = setupLong ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor = color.white, size = size.small)

bgcolor(setupLong  ? color.new(color.green, 92) : na, title="bg long setup")
bgcolor(setupShort ? color.new(color.red,   92) : na, title="bg short setup")

// -----------------------------------------------------------------------------
// Alerts (one fires whenever a fresh setup is confirmed on bar close)
// -----------------------------------------------------------------------------
alertcondition(setupLong,
     title  = "LONG Wave4->5 setup",
     message= "LONG {{ticker}} {{interval}}  trig={{plot_0}}  sl={{plot_1}}  tp={{plot_2}}")
alertcondition(setupShort,
     title  = "SHORT Wave4->5 setup",
     message= "SHORT {{ticker}} {{interval}} trig={{plot_0}}  sl={{plot_1}}  tp={{plot_2}}")

plot(trigPrice, "trigger", display=display.none)
plot(stopPrice, "stop",    display=display.none)
plot(tgtPrice,  "target",  display=display.none)


// -----------------------------------------------------------------------------
// Diagnostics panel - guaranteed visible. Should be in TOP-LEFT corner of the
// chart pane. If you don't see it after pasting, the script wasn't reloaded.
// -----------------------------------------------------------------------------
SCRIPT_VERSION = "v2.1 bugfix 2026-05-27"

var int diagSetups = 0
var int diagFills  = 0
var int diagDirSwitch = 0
if setupLong or setupShort
    diagSetups := diagSetups + 1
if filledLong or filledShort
    diagFills := diagFills + 1
// Detect direction switch (long pending becomes short pending or v.v.)
var bool diagLastDir = true
if (setupLong or setupShort) and pendIsLong != diagLastDir
    diagDirSwitch := diagDirSwitch + 1
diagLastDir := setupLong ? true : setupShort ? false : diagLastDir

// Build table on every bar so it is visible right from the chart start.
var table diagTbl = table.new(position.top_left, 2, 8,
     bgcolor      = color.new(color.black, 20),
     border_color = color.new(color.yellow, 0),
     border_width = 2,
     frame_color  = color.new(color.yellow, 0),
     frame_width  = 2)

ratioStr = diagSetups > 0
     ? str.tostring(math.round(diagFills * 100.0 / diagSetups)) + "%"
     : "n/a"
ratioColor = diagSetups == 0
     ? color.gray
     : (diagFills <= diagSetups
         ? color.new(color.green, 30)
         : color.new(color.red, 0))

table.cell(diagTbl, 0, 0, "ELLIOTT 4->5",      bgcolor=color.new(color.yellow, 0),
     text_color=color.black, text_size=size.normal)
table.cell(diagTbl, 1, 0, SCRIPT_VERSION,       bgcolor=color.new(color.yellow, 0),
     text_color=color.black, text_size=size.small)
table.cell(diagTbl, 0, 1, "setups detected",   bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 1, str.tostring(diagSetups),
     bgcolor=color.new(color.black, 20), text_color=color.white)
table.cell(diagTbl, 0, 2, "trades (fills)",     bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 2, str.tostring(diagFills),
     bgcolor=color.new(color.black, 20), text_color=color.white)
table.cell(diagTbl, 0, 3, "fills / setups",     bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 3, ratioStr,
     bgcolor=ratioColor, text_color=color.white,
     tooltip="should be <= 100%. If higher = stray entries bug = fix not applied")
table.cell(diagTbl, 0, 4, "dir switches",       bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 4, str.tostring(diagDirSwitch),
     bgcolor=color.new(color.black, 20), text_color=color.white)
table.cell(diagTbl, 0, 5, "in position",        bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 5,
     inPos ? "YES (" + (posDir == 1 ? "L" : "S") + ")" : "flat",
     bgcolor=inPos ? color.new(color.blue, 50) : color.new(color.black, 20),
     text_color=color.white)
table.cell(diagTbl, 0, 6, "pending",            bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 6,
     pendOn ? (pendIsLong ? "LONG " : "SHORT ") + str.tostring(pendBarsLeft) + " bars" : "none",
     bgcolor=pendOn ? color.new(color.orange, 50) : color.new(color.black, 20),
     text_color=color.white)
table.cell(diagTbl, 0, 7, "posStop / posTgt",   bgcolor=color.new(color.gray, 50),
     text_color=color.white)
table.cell(diagTbl, 1, 7,
     inPos ? str.tostring(posStop, "#.###") + " / " + str.tostring(posTarget, "#.###") : "-",
     bgcolor=color.new(color.black, 20), text_color=color.white)
