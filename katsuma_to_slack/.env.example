# ===== Gmail (IMAP) =====
# Gmail のアドレス
GMAIL_ADDRESS=your.address@gmail.com
# Google アカウントの「アプリパスワード」を使用してください（通常パスワードはNG）
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# IMAP サーバー（通常はそのまま）
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# ===== 取得対象のメルマガ条件 =====
# 勝間和代さんのメルマガの送信元（環境に合わせて変更）
KATSUMA_FROM=info@kazuyokatsuma.com
# 件名フィルタ（部分一致, 任意）
KATSUMA_SUBJECT_CONTAINS=勝間和代
# 検索対象フォルダ
GMAIL_MAILBOX=INBOX
# 何日前まで遡るか（毎日 cron で動かすなら 2 で十分）
LOOKBACK_DAYS=2

# ===== Slack =====
# 既に動いている Incoming Webhook URL（必須）
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ▼ ここから下は「任意」: Bot Token があると スレッド返信 / パーマリンク取得が可能
# xoxb- で始まる Bot User OAuth Token (chat:write, chat:write.public, channels:history)
SLACK_BOT_TOKEN=
# 投稿先チャンネル ID（Webhook と同じチャンネルを推奨。例: C0123456789）
SLACK_CHANNEL_ID=

# ===== リマインダー（間隔反復学習） =====
# 1,3,7,30 日後に「あの記事もう一度読み返しましょう」を投げます。カンマ区切りで変更可。
REVIEW_INTERVALS_DAYS=1,3,7,30

# 通知を投げる時間帯（ローカル時刻, 24h）。 cron をこの時間に合わせるのが楽。
REMIND_HOUR=8

# ===== 学習ワーク =====
# template = 外部APIなしで動く固定問い (デフォルト)
# llm      = OpenAI 互換 API でケース別の問いを生成 (要 OPENAI_API_KEY)
# off      = ワークを投稿しない (本文だけ流す)
WORKSHEET_MODE=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 保存先 =====
DB_PATH=./katsuma.sqlite3
