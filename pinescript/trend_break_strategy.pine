//@version=5
// =====================================================================================
//  大トレンドブレイク戦略  (Python 検証ツール完全互換版 / Strategy / H1 最適化済)
//  ★★ VERSION 2026-05-18-1345  CRITICAL BUGFIX: SL/TP がロックされない致命バグ修正 ★★
//
//  ▶ 1時間足 (H1) 専用に設計されています。
//     他の時間足にチャートを切り替えると、画面中央に大きく
//     「⚠️ H1 ではありません」の警告が出ます。
//
//  Python リポジトリ:  cursor/pine-script-trend-break-backtester-51bc
//  対応 Python 設定:   configs/best_<SYMBOL>.json
//
//  目的:
//    Python 側で 5 通貨 (XAUUSD/XAGUSD/GBPJPY/USDJPY/EURJPY) 11.5 年分の H1 で
//    最適化した「中期 (3か月) 節目を 1か月ノータッチで実体ブレイク」戦略を
//    TradingView 上で完全再現し、エントリー / SL / TP の位置を視覚化する。
//
//  Python 側と同等のロジック:
//    1. レベル計算: highLevel3m = ta.highest(high[1], lookback_3m)   (現在バー除外)
//    2. 接触除外  : ta.highest(high[1], exclude_recent_3m) < highLevel3m  (strict <)
//    3. 突破     : close > highLevel3m
//    4. SL        : entry - sl_atr_mult * ATR(14)
//    5. TP        : entry + tp_rr * |entry - SL|
//    6. リスク管理: 各トレード資金の risk_pct % をリスク
//
//  プリセット (configs/best_*.json と完全一致):
//    XAUUSD: lookback_3m=480 exclude=120 sl_atr=2.0 tp_rr=3.0 session=全
//    XAGUSD: lookback_3m=360 exclude=180 sl_atr=2.0 tp_rr=3.0 session=asia+ny
//    GBPJPY: lookback_3m=360 exclude=180 sl_atr=2.5 tp_rr=3.0 session=asia+ny
//    USDJPY: lookback_3m=480 exclude=180 sl_atr=2.0 tp_rr=3.0 session=asia+ny
//    EURJPY: lookback_3m=360 exclude= 60 sl_atr=2.5 tp_rr=3.0 session=全  margin=0.5
// =====================================================================================
strategy(
     title             = "Trend-Break Strategy (Python compatible)",
     shorttitle        = "TrendBreakV1",
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.0,
     slippage          = 0,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 100,
     max_bars_back           = 5000
 )


// =====================================================================================
//  H1 (1時間足) チェック  ★ NEW ★
//  チャートの時間足が 60 分でない場合、画面中央に大きく警告を出す
// =====================================================================================
is_h1 = timeframe.in_seconds() == 3600
if barstate.islast and not is_h1
    var label tf_warn = na
    label.delete(tf_warn)
    tf_warn := label.new(bar_index, (high + low) / 2,
         "⚠️ 1時間足 (H1) ではありません\n現在: " + timeframe.period + "\n\n" +
         "このストラテジーは H1 専用に最適化されています。\n" +
         "チャート上部のタイムフレーム選択で「1時間」に切り替えてください。",
         xloc=xloc.bar_index, yloc=yloc.price,
         color=color.new(color.red, 10), textcolor=color.white,
         style=label.style_label_center, size=size.huge)


// =====================================================================================
//  入力パラメータ
// =====================================================================================
grp_pre  = "▼ プリセット (まず選ぶ)"
preset   = input.string("XAUUSD", "通貨プリセット", options=["XAUUSD", "XAGUSD", "GBPJPY", "USDJPY", "EURJPY", "カスタム"], group=grp_pre, tooltip="選ぶと下のパラメータが自動で書き換わる (カスタム以外)")

grp_ind  = "▼ インジケーター・パラメータ (Pine 互換)"
in_lookback_3m       = input.int(480,  "中期 lookback_3m  (節目を探す本数)", minval=10, group=grp_ind)
in_exclude_recent_3m = input.int(120,  "中期 exclude_recent_3m (直近未接触本数)", minval=1, group=grp_ind)
in_lookback          = input.int(5000, "長期 lookback (参考表示用)",            minval=10, group=grp_ind)
in_exclude_recent    = input.int(760,  "長期 exclude_recent (参考表示用)",      minval=1, group=grp_ind)
strict_warmup        = input.bool(true, "strict warm-up (lookback本未満ではシグナル抑制)", group=grp_ind)

grp_lvl  = "▼ レベル種別 (Python: level_kind)"
level_kind = input.string("mid", "level_kind", options=["mid", "long", "confluence"], group=grp_lvl, tooltip="mid=中期のみ / long=長期のみ / confluence=両方同時")

grp_risk = "▼ リスク管理"
sl_atr_mult        = input.float(2.0, "SL = entry ± N×ATR  (sl_atr_mult)", minval=0.1, step=0.1, group=grp_risk)
tp_rr              = input.float(3.0, "TP = entry ± RR×|entry-SL|  (tp_rr)", minval=0.1, step=0.1, group=grp_risk)
atr_period         = input.int(14,    "ATR period", minval=2, group=grp_risk)
risk_per_trade_pct = input.float(1.0, "1 トレードリスク % (口座資金に対する)", minval=0.01, maxval=10.0, step=0.1, group=grp_risk)

grp_filt = "▼ プリトレード・フィルタ"
session_filter_enabled = input.bool(false, "セッションフィルタを有効化", group=grp_filt)
filter_asia            = input.bool(true,  "  Asia (00-07,21-24 UTC)", group=grp_filt)
filter_europe          = input.bool(false, "  Europe (07-13 UTC)",      group=grp_filt)
filter_ny              = input.bool(true,  "  NY (13-21 UTC)",          group=grp_filt)
min_breakout_margin    = input.float(0.0, "min_breakout_margin_atr (弱いブレイク除外)", minval=0.0, step=0.1, group=grp_filt)

grp_dir  = "▼ 方向"
allow_long  = input.bool(true, "ロング許可",   group=grp_dir)
allow_short = input.bool(true, "ショート許可", group=grp_dir)

grp_view = "▼ 表示オプション"
plot_long_level = input.bool(true, "長期ライン (緑/赤)",   group=grp_view)
plot_mid_level  = input.bool(true, "中期ライン (黄/桃)",   group=grp_view)
plot_mid_median = input.bool(true, "中期中央線 (青)",      group=grp_view)
show_levels_only_when_unbroken = input.bool(true, "未ブレイクのライン部分のみ表示", group=grp_view)


// =====================================================================================
//  プリセット適用 (Python configs/best_*.json と完全一致)
//  Pine v5 の switch 文で書く (多段三項演算子は構文エラーになる)
// =====================================================================================
preset_lookback_3m = switch preset
    "XAUUSD" => 480
    "XAGUSD" => 360
    "GBPJPY" => 360
    "USDJPY" => 480
    "EURJPY" => 360
    => in_lookback_3m

preset_exclude_recent_3m = switch preset
    "XAUUSD" => 120
    "XAGUSD" => 180
    "GBPJPY" => 180
    "USDJPY" => 180
    "EURJPY" => 60
    => in_exclude_recent_3m

preset_sl_atr_mult = switch preset
    "GBPJPY" => 2.5
    "EURJPY" => 2.5
    "カスタム" => sl_atr_mult
    => 2.0

preset_session_enabled = preset == "XAGUSD" or preset == "GBPJPY" or preset == "USDJPY"
preset_filter_asia     = true
preset_filter_europe   = false
preset_filter_ny       = true
preset_margin          = preset == "EURJPY" ? 0.5 : 0.0

// 実際に使う値 (プリセット優先、カスタム時のみ入力値)
is_custom         = preset == "カスタム"
lookback_3m       = is_custom ? in_lookback_3m         : preset_lookback_3m
exclude_recent_3m = is_custom ? in_exclude_recent_3m   : preset_exclude_recent_3m
use_sl_atr        = is_custom ? sl_atr_mult            : preset_sl_atr_mult
use_session_on    = is_custom ? session_filter_enabled : preset_session_enabled
use_f_asia        = is_custom ? filter_asia            : preset_filter_asia
use_f_europe      = is_custom ? filter_europe          : preset_filter_europe
use_f_ny          = is_custom ? filter_ny              : preset_filter_ny
use_margin        = is_custom ? min_breakout_margin    : preset_margin


// =====================================================================================
//  インジケーター計算 (Python "intended" モード = 現在バー除外)
// =====================================================================================
highLevel3m = ta.highest(high[1], lookback_3m)
lowLevel3m  = ta.lowest (low[1],  lookback_3m)
highLevel   = ta.highest(high[1], in_lookback)
lowLevel    = ta.lowest (low[1],  in_lookback)
midMedian3m = (highLevel3m + lowLevel3m) / 2.0

// 直近接触除外 (Python と同一: shift(1).rolling.max/min)
recentHighMax3m = ta.highest(high[1], exclude_recent_3m)
recentLowMin3m  = ta.lowest (low[1],  exclude_recent_3m)
recentHighMax   = ta.highest(high[1], in_exclude_recent)
recentLowMin    = ta.lowest (low[1],  in_exclude_recent)

noRecentHighTouch3m = recentHighMax3m < highLevel3m
noRecentLowTouch3m  = recentLowMin3m  > lowLevel3m
noRecentHighTouch   = recentHighMax   < highLevel
noRecentLowTouch    = recentLowMin    > lowLevel

longCond3m  = close > highLevel3m and noRecentHighTouch3m
shortCond3m = close < lowLevel3m  and noRecentLowTouch3m
longCond    = close > highLevel   and noRecentHighTouch
shortCond   = close < lowLevel    and noRecentLowTouch

// level_kind による選択
longSig  = level_kind == "long" ? longCond  : level_kind == "mid" ? longCond3m  : (longCond  and longCond3m)
shortSig = level_kind == "long" ? shortCond : level_kind == "mid" ? shortCond3m : (shortCond and shortCond3m)

// strict warm-up: 必要本数に満たない bar はシグナル抑制
warmup_ok = bar_index >= math.max(lookback_3m, exclude_recent_3m) + 5
longSig  := strict_warmup and not warmup_ok ? false : longSig
shortSig := strict_warmup and not warmup_ok ? false : shortSig

// 方向制限
longSig  := allow_long  ? longSig  : false
shortSig := allow_short ? shortSig : false


// =====================================================================================
//  プリトレード・フィルタ (Python backtest._apply_pretrade_filters と同一)
// =====================================================================================
//---- 1) セッションフィルタ (Python: entry バーの hour で判定 → 次バー始値約定なので
//        Pine では「次バーの hour」を予測する必要があるが、ここでは現在バーの hour を
//        基準とする = 約定時はだいたい同セッション)
h = hour(time, "UTC")
sess_asia   = (h >= 0  and h < 7)  or (h >= 21 and h < 24)
sess_europe = (h >= 7  and h < 13)
sess_ny     = (h >= 13 and h < 21)
sess_pass = not use_session_on or (
     (sess_asia   and use_f_asia)   or
     (sess_europe and use_f_europe) or
     (sess_ny     and use_f_ny)
 )

//---- 2) ブレイクアウト・マージン・フィルタ
atrVal = ta.atr(atr_period)
margin_long  = use_margin > 0 ? (close - highLevel3m) / atrVal : 10.0
margin_short = use_margin > 0 ? (lowLevel3m  - close) / atrVal : 10.0
margin_pass_long  = use_margin > 0 ? margin_long  >= use_margin : true
margin_pass_short = use_margin > 0 ? margin_short >= use_margin : true

// 最終シグナル
finalLong  = longSig  and sess_pass and margin_pass_long
finalShort = shortSig and sess_pass and margin_pass_short


// =====================================================================================
//  注文ロジック  (Python backtest engine と一致)
// =====================================================================================
// 流れ:
//   bar X (シグナルバー): close で finalLong/finalShort 確定 → strategy.entry 予約
//   bar X+1 (約定バー)  : open で fill → このバーで SL/TP を「シグナルバーの ATR」で固定
//   bar X+2..             : SL/TP は固定値で trail せず保持
//
// Python では entry_atr = atr_series[t-1] (=シグナルバーの ATR)
// Pine では bar X+1 における atrVal[1] = ATR at bar X = シグナルバーの ATR  → 一致
// =====================================================================================
var int    signal_bar = na   // シグナル発火バーの bar_index を記憶
var float  locked_sl  = na   // 約定後に確定する SL (一度設定したら不変)
var float  locked_tp  = na   // 同上

// ポジションサイズ計算 (Python と同じ式: equity × risk% / |entry-SL|)
// 暫定 SL を close と現バー ATR から見積もって qty 算出
est_entry      = close
est_sl_long    = est_entry - use_sl_atr * atrVal
est_sl_short   = est_entry + use_sl_atr * atrVal
risk_money     = strategy.equity * (risk_per_trade_pct / 100.0)
qty_long       = math.max(risk_money / math.max(math.abs(est_entry - est_sl_long),  1e-12), 1e-6)
qty_short      = math.max(risk_money / math.max(math.abs(est_entry - est_sl_short), 1e-12), 1e-6)

// シグナル発火 → 次バー始値で約定予約
if finalLong and strategy.position_size == 0
    signal_bar := bar_index
    strategy.entry("L", strategy.long, qty=qty_long,
         comment="Long signal @" + str.tostring(close, format.mintick))
if finalShort and strategy.position_size == 0
    signal_bar := bar_index
    strategy.entry("S", strategy.short, qty=qty_short,
         comment="Short signal @" + str.tostring(close, format.mintick))

// 約定バー (bar_index == signal_bar + 1) で SL/TP を固定
if not na(signal_bar) and bar_index == signal_bar + 1 and strategy.position_size != 0
    sig_atr = nz(atrVal[1], atrVal)  // シグナルバーの ATR
    if strategy.position_size > 0
        locked_sl := strategy.position_avg_price - use_sl_atr * sig_atr
        locked_tp := strategy.position_avg_price + tp_rr * (use_sl_atr * sig_atr)
    else
        locked_sl := strategy.position_avg_price + use_sl_atr * sig_atr
        locked_tp := strategy.position_avg_price - tp_rr * (use_sl_atr * sig_atr)

// SL/TP を毎バー発注 (Pine は最新の strategy.exit が反映されるが値は同じなので無問題)
if strategy.position_size > 0 and not na(locked_sl)
    strategy.exit("L-X", from_entry="L", stop=locked_sl, limit=locked_tp)
if strategy.position_size < 0 and not na(locked_sl)
    strategy.exit("S-X", from_entry="S", stop=locked_sl, limit=locked_tp)

// ポジションクローズ後はステートをリセット
// ★ BUGFIX 2026-05-18-1345: シグナルバー自身では reset しない (signal_bar が消える)
//   位置 != 0 だった経歴がある (= locked_sl が既にセットされた) 状態で
//   position_size == 0 に戻ったときだけリセットする。
if strategy.position_size == 0 and not na(locked_sl)
    locked_sl  := na
    locked_tp  := na
    signal_bar := na


// =====================================================================================
//  プロット (Pine 原版 + 戦略的視覚化 + 決済可視化)
// =====================================================================================
// ラインの表示 (style_linebr で「未ブレイク区間のみ」描画される)
plot(plot_long_level ? highLevel : na, title="長期 高値ライン", color=color.new(color.green,  0), linewidth=2, style=show_levels_only_when_unbroken ? plot.style_linebr : plot.style_line)
plot(plot_long_level ? lowLevel  : na, title="長期 安値ライン", color=color.new(color.red,    0), linewidth=2, style=show_levels_only_when_unbroken ? plot.style_linebr : plot.style_line)
plot(plot_mid_level  ? highLevel3m : na, title="中期 高値ライン", color=color.new(color.yellow,  0), linewidth=2, style=show_levels_only_when_unbroken ? plot.style_linebr : plot.style_line)
plot(plot_mid_level  ? lowLevel3m  : na, title="中期 安値ライン", color=color.new(color.fuchsia, 0), linewidth=2, style=show_levels_only_when_unbroken ? plot.style_linebr : plot.style_line)
plot(plot_mid_median ? midMedian3m : na, title="中期 中央値ライン", color=color.new(#2195f3, 0), linewidth=1, style=plot.style_line)

// シグナル発火マーカー (=エントリー候補。実約定は次バー始値)
plotshape(finalLong,  title="LONG signal",  location=location.belowbar, style=shape.triangleup,   color=color.new(color.green, 0), size=size.small)
plotshape(finalShort, title="SHORT signal", location=location.abovebar, style=shape.triangledown, color=color.new(color.red,   0), size=size.small)

// 背景塗り潰し (シグナル発火バー)
bgcolor(finalLong  ? color.new(color.green, 85) : na, title="LONG bg")
bgcolor(finalShort ? color.new(color.red,   85) : na, title="SHORT bg")

// =====================================================================================
//  エントリー値段ラベル ★ NEW ★
//    シグナル発火バーで「LONG @ 4,531.14」のような吹き出しを出す
//    値段はバーの close (実体ブレイク基準) — 実約定は次バー始値だがほぼ同値
// =====================================================================================
grp_lbl  = "▼ エントリー値段ラベル"
show_entry_label    = input.bool(true, "エントリー値段を吹き出しで表示", group=grp_lbl)
entry_label_size    = input.string("normal", "ラベルサイズ", options=["tiny","small","normal","large"], group=grp_lbl)
entry_label_compact = input.bool(false, "コンパクト表示 (価格のみ)", group=grp_lbl)

entry_size_val = switch entry_label_size
    "tiny"  => size.tiny
    "small" => size.small
    "large" => size.large
    => size.normal

if show_entry_label and finalLong
    txt_l = entry_label_compact ? str.tostring(close, format.mintick) : "🟢 LONG @ " + str.tostring(close, format.mintick)
    tip_l = "Long signal. close=" + str.tostring(close, format.mintick) + ", level=" + str.tostring(highLevel3m, format.mintick) + ", ATR=" + str.tostring(atrVal, format.mintick) + ", SL=" + str.tostring(close - use_sl_atr * atrVal, format.mintick) + ", TP=" + str.tostring(close + tp_rr * use_sl_atr * atrVal, format.mintick)
    label.new(bar_index, low - atrVal * 0.5, txt_l,
              xloc=xloc.bar_index, yloc=yloc.price,
              color=color.new(color.green, 0), textcolor=color.white,
              style=label.style_label_up, size=entry_size_val,
              tooltip=tip_l)

if show_entry_label and finalShort
    txt_s = entry_label_compact ? str.tostring(close, format.mintick) : "🔴 SHORT @ " + str.tostring(close, format.mintick)
    tip_s = "Short signal. close=" + str.tostring(close, format.mintick) + ", level=" + str.tostring(lowLevel3m, format.mintick) + ", ATR=" + str.tostring(atrVal, format.mintick) + ", SL=" + str.tostring(close + use_sl_atr * atrVal, format.mintick) + ", TP=" + str.tostring(close - tp_rr * use_sl_atr * atrVal, format.mintick)
    label.new(bar_index, high + atrVal * 0.5, txt_s,
              xloc=xloc.bar_index, yloc=yloc.price,
              color=color.new(color.red, 0), textcolor=color.white,
              style=label.style_label_down, size=entry_size_val,
              tooltip=tip_s)


// =====================================================================================
//  決済 (Exit) 可視化  ★ NEW (堅牢版) ★
//
//    2 系統で確実に視覚化:
//      A. plotshape で「決済が確定したバー」をハデにマーク (緑✕=TP / 赤✕=SL)
//         → strategy.closedtrades が 1 件でもあれば必ず出る
//      B. for ループで全クローズトレードの「エントリー→決済」ラインを描画
//         → 線がチャート上で過去をなぞって視覚的に強力
//      C. 保有中ポジションの SL/TP/エントリー水平線
//         → 「今ここで切る」価格を 3 本のラインで提示
//
//    トレード件数の診断情報も右上テーブルに表示する
// =====================================================================================
grp_exit  = "▼ 決済可視化"
show_exit_shapes  = input.bool(true, "決済点を ✕ マーカーで強調表示", group=grp_exit)
show_exit_lines   = input.bool(true, "エントリー→決済を線で結ぶ", group=grp_exit)
max_trades_drawn  = input.int(80, "ライン描画件数の上限", minval=1, maxval=500, group=grp_exit)
show_pnl_label    = input.bool(true, "決済点に損益 $ を表示", group=grp_exit)
show_open_sl_tp   = input.bool(true, "保有中ポジの SL/TP 水平線", group=grp_exit)

// ---- A) plotshape による「決済が確定したバー」のハデなマーキング ----
//      Pine の strategy.closedtrades の値が前バーから増えた瞬間 = 決済成立
trade_just_closed = strategy.closedtrades > nz(strategy.closedtrades[1], 0)
last_trade_pnl   = trade_just_closed ? strategy.closedtrades.profit(strategy.closedtrades - 1) : 0.0
last_was_win     = trade_just_closed and last_trade_pnl >  0
last_was_loss    = trade_just_closed and last_trade_pnl <= 0

plotshape(show_exit_shapes and last_was_win,  title="✕ WIN exit",  location=location.abovebar,
          style=shape.xcross, color=color.new(color.lime, 0), size=size.large, text="WIN",  textcolor=color.white)
plotshape(show_exit_shapes and last_was_loss, title="✕ LOSS exit", location=location.belowbar,
          style=shape.xcross, color=color.new(color.red,  0), size=size.large, text="LOSS", textcolor=color.white)

// ---- B) for ループで「エントリー→決済」のラインを描く ----
if show_exit_lines and barstate.islast
    total_closed = strategy.closedtrades
    start_i = math.max(0, total_closed - max_trades_drawn)
    for i = start_i to total_closed - 1
        ent_bar  = strategy.closedtrades.entry_bar_index(i)
        ent_pr   = strategy.closedtrades.entry_price(i)
        ext_bar  = strategy.closedtrades.exit_bar_index(i)
        ext_pr   = strategy.closedtrades.exit_price(i)
        pnl_m    = strategy.closedtrades.profit(i)
        is_win   = pnl_m > 0
        col      = is_win ? color.new(color.lime, 0) : color.new(color.red, 0)

        line.new(x1=ent_bar, y1=ent_pr, x2=ext_bar, y2=ext_pr,
                 xloc=xloc.bar_index, color=col, width=2, style=line.style_solid)

        if show_pnl_label
            sign_str = pnl_m >= 0 ? "+$" : "-$"
            txt = sign_str + str.tostring(math.abs(pnl_m), "#.00")
            label.new(x=ext_bar, y=ext_pr, text=txt,
                      xloc=xloc.bar_index, yloc=yloc.price,
                      color=color.new(col, 30), textcolor=color.white,
                      style=is_win ? label.style_label_down : label.style_label_up,
                      size=size.small)

// ---- C) 保有中ポジションの SL/TP/エントリー水平線 ----
plot(show_open_sl_tp and strategy.position_size != 0 ? locked_sl : na,
     title="現ポジ SL", color=color.new(color.red, 0), linewidth=3, style=plot.style_linebr)
plot(show_open_sl_tp and strategy.position_size != 0 ? locked_tp : na,
     title="現ポジ TP", color=color.new(color.lime, 0), linewidth=3, style=plot.style_linebr)
plot(show_open_sl_tp and strategy.position_size != 0 ? strategy.position_avg_price : na,
     title="現ポジ エントリー", color=color.new(color.aqua, 0), linewidth=2, style=plot.style_linebr)


// =====================================================================================
//  ★★ オープン中ポジションの完全可視化 ★★ (NEW)
//
//  strategy.closedtrades が 0 件でも「今ポジションを持っている」状況を
//  視覚的に伝える。これで「決済点が見えない」=「まだ決済してないだけ」が
//  ハッキリ分かる。
//
//  - エントリー位置から現在バーまで「進行中」を太線で結ぶ (緑=含み益 / 赤=含み損)
//  - エントリー価格・SL 価格・TP 価格を各々大きなラベルで表示
//  - 現在の含み損益 ($ と %) を画面右端に表示
// =====================================================================================
if is_h1 and strategy.position_size != 0 and barstate.islast
    ent_pr   = strategy.position_avg_price
    is_long  = strategy.position_size > 0
    cur_pnl  = (close - ent_pr) * (is_long ? 1 : -1) * math.abs(strategy.position_size)
    cur_pnl_pct = (close - ent_pr) / ent_pr * 100 * (is_long ? 1 : -1)
    pos_col  = cur_pnl >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0)

    // エントリーバー (現在ポジの平均約定バー) を推定 — Pine の strategy.opentrades から取得
    ent_bar = strategy.opentrades > 0 ? strategy.opentrades.entry_bar_index(0) : bar_index

    // 進行中ライン
    line.new(x1=ent_bar, y1=ent_pr, x2=bar_index, y2=close,
             xloc=xloc.bar_index, color=pos_col, width=3, style=line.style_solid)

    // エントリー位置ラベル
    label.new(ent_bar, ent_pr,
              (is_long ? "🟢 IN: LONG @ " : "🔴 IN: SHORT @ ") + str.tostring(ent_pr, format.mintick),
              xloc=xloc.bar_index, yloc=yloc.price,
              color=color.new(color.aqua, 0), textcolor=color.white,
              style=label.style_label_right, size=size.normal)

    // SL ラベル (右側に固定)
    if not na(locked_sl)
        label.new(bar_index + 5, locked_sl,
                  "SL @ " + str.tostring(locked_sl, format.mintick),
                  xloc=xloc.bar_index, yloc=yloc.price,
                  color=color.new(color.red, 0), textcolor=color.white,
                  style=label.style_label_left, size=size.normal)

    // TP ラベル (右側に固定)
    if not na(locked_tp)
        label.new(bar_index + 5, locked_tp,
                  "TP @ " + str.tostring(locked_tp, format.mintick),
                  xloc=xloc.bar_index, yloc=yloc.price,
                  color=color.new(color.lime, 0), textcolor=color.white,
                  style=label.style_label_left, size=size.normal)

    // 現在の含み損益ラベル
    pnl_sign = cur_pnl >= 0 ? "+" : ""
    label.new(bar_index, close,
              "現在 " + pnl_sign + "$" + str.tostring(cur_pnl, "#.00") + "  (" + pnl_sign + str.tostring(cur_pnl_pct, "#.00") + "%)",
              xloc=xloc.bar_index, yloc=yloc.price,
              color=pos_col, textcolor=color.white,
              style=is_long ? label.style_label_down : label.style_label_up, size=size.large)


// =====================================================================================
//  アラート定義 (TradingView の Alerts から有効化可能)
// =====================================================================================
alertcondition(finalLong,  title="🟢 Long Signal",  message="{{ticker}}: LONG signal at {{close}} (level break detected)")
alertcondition(finalShort, title="🔴 Short Signal", message="{{ticker}}: SHORT signal at {{close}} (level break detected)")


// =====================================================================================
//  情報パネル (右上)
// =====================================================================================
if barstate.islast
    var table info = table.new(position.top_right, 2, 13, frame_color=color.gray, frame_width=1)
    table.cell(info, 0, 0, "★ VERSION", bgcolor=color.new(color.orange, 0), text_color=color.white, text_size=size.normal)
    table.cell(info, 1, 0, "2026-05-18-1345", bgcolor=color.new(color.orange, 0), text_color=color.white, text_size=size.normal)
    table.cell(info, 0, 1, "プリセット",    text_size=size.small)
    table.cell(info, 1, 1, preset,          text_size=size.small)
    table.cell(info, 0, 2, "level_kind",    text_size=size.small)
    table.cell(info, 1, 2, level_kind,      text_size=size.small)
    table.cell(info, 0, 3, "lookback_3m",   text_size=size.small)
    table.cell(info, 1, 3, str.tostring(lookback_3m),       text_size=size.small)
    table.cell(info, 0, 4, "exclude_3m",    text_size=size.small)
    table.cell(info, 1, 4, str.tostring(exclude_recent_3m), text_size=size.small)
    table.cell(info, 0, 5, "SL ATR×",       text_size=size.small)
    table.cell(info, 1, 5, str.tostring(use_sl_atr),        text_size=size.small)
    table.cell(info, 0, 6, "TP RR",         text_size=size.small)
    table.cell(info, 1, 6, str.tostring(tp_rr),             text_size=size.small)
    table.cell(info, 0, 7, "session filter", text_size=size.small)
    table.cell(info, 1, 7, use_session_on ? ((use_f_asia?"A":"") + (use_f_europe?"E":"") + (use_f_ny?"N":"")) : "OFF", text_size=size.small)
    table.cell(info, 0, 8, "margin filter", text_size=size.small)
    table.cell(info, 1, 8, use_margin > 0 ? str.tostring(use_margin) + " ATR" : "OFF", text_size=size.small)
    // 診断情報 ★ NEW ★
    table.cell(info, 0, 9, "── 診断 ──", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 9, "",            bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(info, 0, 10, "クローズ済トレード", text_size=size.small)
    table.cell(info, 1, 10, str.tostring(strategy.closedtrades), text_size=size.small, text_color=strategy.closedtrades > 0 ? color.green : color.orange)
    table.cell(info, 0, 11, "現在保有中", text_size=size.small)
    table.cell(info, 1, 11, strategy.position_size > 0 ? "🟢 LONG " + str.tostring(strategy.position_size, "#.##") : strategy.position_size < 0 ? "🔴 SHORT " + str.tostring(-strategy.position_size, "#.##") : "なし (待機中)", text_size=size.small)
